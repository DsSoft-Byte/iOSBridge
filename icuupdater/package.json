{
  "name": "icures-updater",
  "version": "1.0.0",
  "description": "iCures OTA Updater",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.dssoft.icures-updater",
    "productName": "iCures Updater",
    "win": {
      "target": "portable",
      "icon": "../icures-electron/assets/icon.ico"
    },
    "directories": { "output": "dist" }
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0"
  }
}
