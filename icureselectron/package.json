{
  "name": "iosbridge",
  "version": "2.2.0",
  "description": "iOSBridge — iDevice toolkit",
  "homepage": "https://www.iosbridge.com",
  "author": "DsSoft",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "prebuild:mac": "node scripts/gen-icons.js && mkdir -p build/native/mac/bin build/native/mac/libs build/native/mac/sshrd",
    "prebuild:linux": "node scripts/gen-icons.js && mkdir -p build/native/linux/bin build/native/linux/libs build/native/linux/sshrd",
    "build:deps": "bash scripts/build-deps.sh",
    "build:deps:clean": "bash scripts/build-deps.sh --clean"
  },
  "build": {
    "appId": "com.dssoft.iosbridge",
    "productName": "iOSBridge",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "extraResources": [
        { "from": "C:\\iCures", "to": "iCures", "filter": ["**/*", "!Username.txt"] }
      ]
    },
    "nsis": {
      "include": "scripts/installer.nsh"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "extraResources": [
        { "from": "build/native/mac/bin",   "to": "bin",   "filter": ["**/*"] },
        { "from": "build/native/mac/libs",  "to": "libs",  "filter": ["**/*"] },
        { "from": "build/native/mac/sshrd", "to": "sshrd", "filter": ["**/*"] }
      ]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icon.png",
      "category": "Utility",
      "maintainer": "iOSBridge",
      "extraResources": [
        { "from": "build/native/linux/bin",   "to": "bin",   "filter": ["**/*"] },
        { "from": "build/native/linux/libs",  "to": "libs",  "filter": ["**/*"] },
        { "from": "build/native/linux/sshrd", "to": "sshrd", "filter": ["**/*"] }
      ]
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.10"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0",
    "sharp": "^0.33.0"
  }
}
